     <StackLayout Margin="10">
            <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="35" TextColor="white" HorizontalTextAlignment="Start" Text="كتب ينصح باقتنائها والقراءة فيها" />
            <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text="وإليك أيها القارئ الكريم أسماء بعض الكتب التي ينبغي أن يشغل بها الوقت ويستفاد منها مع العلم بأن العلم كثير والعمر قصير فينبغي أن يبدأ بالأهم فالأهم والأنفاس معدودة والأوقات محدودة فينبغي حفظها فيما ينفع وصونها عما يضر لأنك مسئول عنها ومحاسب عليها ومجزي على ما عملت فيها وإليك أسماء الكتب:"/>
            <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text="وإليك أيها القارئ الكريم أسماء بعض ال"/>
            <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text="وإليك أيها القارئ الكريم أسماء بعض ال"/>
            <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 1- تفسير القرآن العظيم لابن كثير."/><Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text="2- تفسير ابن سعدي."/><Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text="3- العقيدة الواسطية لشيخ الإسلام ابن تيمية."/><Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text="4- لمعة الاعتقاد الهادي إلى سبيل الرشاد لابن قدامة."/><Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text="5- شرح العقيدة الطحاوية."/><Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text="6- التجريد الصريح لأحاديث الجامع الصحيح (مختصر صحيح البخاري) للزبيدي."/><Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text="7- مختصر صحيح مسلم للمنذري."/><Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text="8- بلوغ المرام من أدلة الأحكام لابن حجر العسقلاني.9- رياض الصالحين للنووي."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 10- مشكاة المصابيح للخطيب التبريزي، وأصلها للبغوي."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 11- الموطأ للإمام مالك بن أنس."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 12- جامع العلوم والحكم لابن رجب."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 13- زاد المعاد في هدي خير العباد لابن القيم."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 14- الإرشاد إلى معرفة الأحكام لابن سعدي يشتمل على مائة سؤال مقرونة بالأجوبة."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 15- منهاج المسلم لأبي بكر الجزائري."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 16- مختصر سيرة الرسول  للشيخ محمد بن عبد الوهاب وابنه عبد الله."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 17- الوابل الصيب لابن القيم في فضل الذكر والدعاء."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 18- الجواب الكافي لمن سأل عن الدواء الشافي لابن القيم في آثار وأضرار الذنوب والمعاصي."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 19- كتاب الكبائر للإمام المذهبي."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 20- إغاثة اللهفان من مصائد الشيطان لابن القيم."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 21- اللؤلؤ والمرجان فيما اتفق عليه الشيخان (البخاري ومسلم)."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 22- العبودية لشيخ الإسلام ابن تيمية."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 23- الفرقان بين أولياء الرحمن وأولياء الشيطان لشيخ الإسلام ابن تيمية."/> <Label LineHeight="15" FontFamily="{Binding Android}" FontSize="Large" TextColor="white" HorizontalTextAlignment="Start" Text=" 24- كما ينصح باقتناء والقراءة في كل من مؤلفات:ابن تيمية وابن القيم والشيخ محمد بن عبد الوهاب وابن سعدي وابن عثيمين والشيخ عبد العزيز بن باز."/>
    </StackLayout>
  </ScrollView>
